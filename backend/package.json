    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prisma": "^7.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
